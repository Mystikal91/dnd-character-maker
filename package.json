{
  "name": "dnd-character-maker",
  "version": "1.12.0-beta",
  "private": true,
  "description": "Offline-first D&D 5e character sheet maker (print and play).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-site.mjs",
    "build:legacy": "tsc --noEmit && vite build --mode legacy",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:corpus": "vitest run src/import/aurora/corpus",
    "icons": "node scripts/make-icons.mjs",
    "data:srd51": "tsx scripts/srd51/build.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@preact/signals": "^1.3.0",
    "preact": "^10.24.0",
    "qrcode-generator": "^2.0.4",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@preact/preset-vite": "^2.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.0"
  }
}
